# Copy to .env and adjust. Never commit .env.

# Cookie file exported from your browser (path inside the container;
# ./data on the host is mounted at /data).
COOKIES_FILE=/data/cookies.json

# Notifications via shoutrrr (https://github.com/nicholas-fedor/shoutrrr), e.g.
#   pushover://shoutrrr:APP_TOKEN@USER_KEY
#   telegram://BOT_TOKEN@telegram?chats=CHAT_ID
#   ntfy://ntfy.sh/YOUR_TOPIC
# Leave empty to disable notifications.
NOTIFY_URL=
# Also notify after successful runs (default: problems only).
NOTIFY_ON_SUCCESS=false

TZ=Europe/Berlin
RUN_AT=04:00
RUN_ON_START=true
LOG_LEVEL=info

# Optional: the User-Agent of the browser you exported the cookies from.
# Some sessions are bound to the browser they were created in.
BROWSER_USER_AGENT=

# Host user/group that owns ./data (see `id -u` / `id -g`).
PUID=1000
PGID=1000
